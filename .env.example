# Start in dry-run mode. Set false only after testing with your chosen GitHub branch.
DRY_RUN=true
GITHUB_OWNER=HPyn
GITHUB_REPO=vanity-metrics
GITHUB_BRANCH=main
GITHUB_PATH=log.md
# Path to a local token file, never the token itself.
GITHUB_TOKEN_SOURCE=./secrets/github_token.txt
TIME_ZONE=Australia/Sydney
WORK_START_HOUR=9
WORK_END_HOUR=17
INTERVAL_MINUTES=30
COMMIT_PROBABILITY=0.4
BUSY_WEEK_MODULO=4
BUSY_WEEK_REMAINDER=0
BUSY_WEEK_MULTIPLIER=2.5
QUIET_WEEK_REMAINDER=2
QUIET_WEEK_MULTIPLIER=0.4
# For a published release, set this to ghcr.io/hpyn/vanity-metrics:v2.0.0.
VANITY_METRICS_IMAGE=vanity-metrics:local
